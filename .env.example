# ===== docker compose uchun umumiy sozlamalar =====
# Nusxa oling: cp .env.example .env

# Tashqi portlar
API_PORT=3000
WEB_PORT=3001
DB_EXTERNAL_PORT=5435

# Brauzer API ga qaysi manzil orqali murojaat qiladi
PUBLIC_API_BASE=http://localhost:3000/api/v1
# Frontend manzillari (vergul bilan bir nechta)
CORS_ORIGIN=http://localhost:3001

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=change_me_db_password
DB_NAME=ctf_db

# JWT (production uchun uzun tasodifiy qiymatlar kiriting: openssl rand -hex 32)
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Jamoadagi maksimal a'zolar soni
TEAM_MAX_SIZE=3

# SMTP (bo'sh qoldirilsa xatlar yuborilmaydi, OTP kodlar API logiga yoziladi)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM='"CTF Platform" <noreply@ctf.uz>'

# Birinchi ishga tushishda yaratiladigan administrator
ADMIN_USERNAME=admin01
ADMIN_EMAIL=admin@ctf.uz
ADMIN_PASSWORD=change_me_admin_password

SWAGGER_ENABLED=true
