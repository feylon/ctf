# Server
PORT=3000
NODE_ENV=development
# Frontend manzillari (vergul bilan bir nechta)
CORS_ORIGIN=http://localhost:3001
SWAGGER_ENABLED=true
TRUST_PROXY=true

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ctf_db
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Jamoadagi maksimal a'zolar soni
TEAM_MAX_SIZE=3

# SMTP (MAIL_HOST bo'sh bo'lsa xatlar yuborilmaydi, OTP kodlar logga yoziladi)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM='"CTF Platform" <noreply@ctf.uz>'

# Seed orqali yaratiladigan admin
ADMIN_USERNAME=admin01
ADMIN_EMAIL=admin@ctf.uz
ADMIN_PASSWORD=admin01
